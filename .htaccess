# ==============================================================================
# Srin Engine - Web Server Security & Routing Rules (.htaccess)
# Developed by Arindam Makar
# ==============================================================================

# 1. Disable Directory Browsing / Indexing
Options -Indexes +FollowSymLinks

# 2. Character Encoding
AddDefaultCharset UTF-8

# 3. Security Headers (Modern Web Defense-in-Depth)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "0"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

# 3b. Deny access to sensitive files: dotfiles, env/db/log/lock/sql files, composer.*, CLI tool
<FilesMatch "(?i)(^\.|\.(env|sqlite[0-9]?|db|log|lock|sql|bak|ini|dist|example|yml|yaml)$|^composer\..+$|^srin$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3c. Block direct access to server-side scripts (allow only front controller index.php)
<FilesMatch "(?i)^(?!index\.php$).*\.(php[0-9s]?|phtml|phar|pht|cgi|pl|py|sh|inc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Map Errors to index.php so 404 is always rendered
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php

# 5. Routing & Core File Cloaking
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct HTTP access to sensitive core directories, CLI tool, and config files
    RewriteRule ^(\.env(?:\..*)?$|composer\..+$|database/|Others/logs/|Config/|Core/|Model/|Controller/|Pages/|Others/|srin$) - [F,L,NC]

    # Block server-side script types and dotfiles under assets/ (route them to the 404 handler)
    RewriteCond %{REQUEST_URI} ^/?assets/ [NC]
    RewriteCond %{REQUEST_URI} (/\.|\.(php[0-9s]?|phtml|phar|pht|cgi|pl|py|sh|inc|bash|exe)(/|$)) [NC]
    RewriteRule ^ index.php [L,QSA]

    # Allow direct HTTP access ONLY for existing static/downloadable files inside assets/
    RewriteCond %{REQUEST_URI} ^/?assets/ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route ALL other requests to index.php
    # Direct access to /core/App.php, /Config/app.php, etc.
    # will be processed by index.php -> Router -> Response::renderError(404)!
    RewriteRule ^ index.php [L,QSA]
</IfModule>
