# ==============================================================================
# Rinswa Engine - Web Server Security & Routing Rules (.htaccess)
# Developed by Arindam Makar
# ==============================================================================

# 1. Disable Directory Browsing / Indexing
Options -Indexes +FollowSymLinks

# 2. Character Encoding
AddDefaultCharset UTF-8

# 3. Security Headers (Defense-in-depth like Laravel)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "0"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

# 3b. Never serve secrets, databases, logs, dependency manifests or dotfiles,
#     even if the project root is (mis)configured as the web root.
<FilesMatch "(?i)(^\.|\.(env|sqlite3?|db|log|lock|bak|sql|ini|md|dist|example|yml|yaml)$|^composer\.(json|lock)$|^srin$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3c. Uploaded/static directories must never execute server-side code.
<IfModule mod_php.c>
    <Directory "assets">
        php_flag engine off
    </Directory>
</IfModule>

# 4. Map Errors to index.php so 404 is always rendered
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php

# 5. Routing & Core File Cloaking
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct HTTP access to sensitive core directories, CLI tool, and config files
    RewriteRule ^(\.env(?:\..*)?$|composer\.(json|lock)$|database/|Others/logs/|Config/|srin$) - [F,L,NC]

    # Block server-side script types and dotfiles under assets/ (route them to the 404 handler)
    RewriteCond %{REQUEST_URI} ^/assets/ [NC]
    RewriteCond %{REQUEST_URI} (\.(php[0-9s]?|phtml|phar|pht|cgi|pl|py|sh|inc)(/|$)|/\.) [NC]
    RewriteRule ^ index.php [L,QSA]

    # Allow direct HTTP access ONLY for existing static/downloadable files inside assets/
    RewriteCond %{REQUEST_URI} ^/assets/ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route ALL other requests to index.php
    # Direct access to /core/App.php, /Config/app.php, etc.
    # will be processed by index.php -> Router -> Response::renderError(404)!
    RewriteRule ^ index.php [L,QSA]
</IfModule>
