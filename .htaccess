# ==============================================================================
# Rinswa Engine - Web Server Security & Routing Rules (.htaccess)
# Developed by Arindam Makar
# ==============================================================================

# 1. Disable Directory Browsing / Indexing
Options -Indexes +FollowSymLinks

# 2. Character Encoding
AddDefaultCharset UTF-8

# 3. Security Headers (Defense-in-depth like Laravel)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

# 4. Map Errors to index.php so 404 is always rendered
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php

# 5. Routing & Core File Cloaking
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct HTTP access to sensitive core directories and config files
    RewriteRule ^(\.env|composer\.(json|lock)|database/|Others/logs/|Config/|srin) - [F,L,NC]

    # Strictly block direct execution of PHP scripts inside assets/
    RewriteCond %{REQUEST_URI} ^/assets/.*\.(php[0-9]?|phtml|phar|phps)$ [NC]
    RewriteRule ^ - [F,L]

    # Allow direct HTTP access ONLY for non-PHP existing static files inside assets/
    RewriteCond %{REQUEST_URI} ^/assets/ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME} !\.(php[0-9]?|phtml|phar|phps)$ [NC]
    RewriteRule ^ - [L]

    # Route ALL other requests to index.php
    # Direct access to /core/App.php, /Config/app.php, etc.
    # will be processed by index.php -> Router -> Response::renderError(404)!
    RewriteRule ^ index.php [L,QSA]
</IfModule>
