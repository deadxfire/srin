/**
 * Handle custom command execution.
 */
function handleCustomCommand(string $commandName, array $args, string $baseDir): void
{
    $dir = $baseDir . '/Command';
    if (!is_dir($dir)) {
        echo color("\n[X] Unknown command: '{$commandName}'.\n", 'red');
        echo "Run " . color("php srin help", 'yellow') . " to see all available commands.\n\n";
        exit(1);
    }

    bootstrapApp($baseDir);

    $normalized = strtolower(str_replace([':', '_'], '-', $commandName));
    $studly = str_replace(' ', '', ucwords(str_replace(['-', ':', '_'], ' ', $commandName)));

    $matchedClass = null;
    $files = glob($dir . '/*.php') ?: [];

    // 1. Check exact class / file name matches
    foreach ($files as $file) {
        $base = basename($file, '.php');
        if (strcasecmp($base, $studly) === 0 || strcasecmp($base, $studly . 'Command') === 0 || strcasecmp($base, $commandName) === 0) {
            require_once $file;
            $candidate = '\\Command\\' . $base;
            if (class_exists($candidate)) {
                $matchedClass = $candidate;
                break;
            }
        }
    }

    // 2. Check property $name on Command classes
    if (!$matchedClass) {
        foreach ($files as $file) {
            require_once $file;
            $base = basename($file, '.php');
            $candidate = '\\Command\\' . $base;
            if (class_exists($candidate)) {
                try {
                    $ref = new \ReflectionClass($candidate);
                    if ($ref->isInstantiable()) {
                        $defaultProps = $ref->getDefaultProperties();
                        $cmdSig = strtolower(trim((string) ($defaultProps['name'] ?? '')));
                        if ($cmdSig !== '' && ($cmdSig === $normalized || $cmdSig === strtolower($commandName))) {
                            $matchedClass = $candidate;
                            break;
                        }
                    }
                } catch (\Throwable $e) {}
            }
        }
    }

    if (!$matchedClass) {
        echo color("\n[X] Unknown command: '{$commandName}'.\n", 'red');
        echo "Run " . color("php srin help", 'yellow') . " to see all available commands.\n\n";
        exit(1);
    }

    try {
        $instance = new $matchedClass();
        $exitCode = 0;
        if (method_exists($instance, 'execute')) {
            $exitCode = (int) $instance->execute($args);
        } elseif (method_exists($instance, 'handle')) {
            $exitCode = (int) $instance->handle($args);
        }
        exit($exitCode);
    } catch (\Throwable $e) {
        echo color("\n[X] Command Execution Error in [{$matchedClass}]:\n", 'red');
        echo $e->getMessage() . "\n";
        echo color("\nStack trace:\n", 'yellow');
        echo $e->getTraceAsString() . "\n\n";
        exit(1);
    }
}

