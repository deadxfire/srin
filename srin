/**
 * Handle make:partial command.
 */
function handleMakePartial(array $args, string $baseDir): void
{
    $name = $args[1] ?? null;

    if (!$name) {
        echo color("\n[!] Please specify a partial name.\n", 'yellow');
        echo "Usage: srin add partial <name>\n";
        echo "Example: srin add partial navbar\n";
        echo "         srin add partial components.card\n\n";
        return;
    }

    $cleanName = str_replace(['\\', '.'], '/', $name);
    $cleanName = strtolower(preg_replace('/[^a-zA-Z0-9_\-\/]/', '', $cleanName));
    $cleanName = trim($cleanName, '/');

    if (str_starts_with($cleanName, 'partials/') || str_starts_with($cleanName, 'components/') || str_starts_with($cleanName, 'includes/')) {
        $partialPath = $baseDir . "/Pages/{$cleanName}.srin.php";
        $includeDot = str_replace('/', '.', $cleanName);
    } else {
        $partialPath = $baseDir . "/Pages/partials/{$cleanName}.srin.php";
        $includeDot = 'partials.' . str_replace('/', '.', $cleanName);
    }

    if (file_exists($partialPath)) {
        $relPath = str_replace($baseDir . '/', '', $partialPath);
        echo color("\n[X] Error: Partial already exists at {$relPath}\n\n", 'red');
        return;
    }

    $partialDir = dirname($partialPath);
    if (!is_dir($partialDir)) {
        @mkdir($partialDir, 0755, true);
    }

    $title = ucwords(str_replace(['-', '_', '/'], ' ', basename($cleanName)));

    $template = <<<HTML
[-- Srin Partial: {$title} --]
<div class="partial-component">
    <!-- Reusable partial HTML or PHP component -->
</div>
HTML;

    file_put_contents($partialPath, $template);

    $relPath = str_replace($baseDir . '/', '', $partialPath);
    echo color("\n[✓] Partial created successfully!", 'green') . "\n";
    echo "  Location: " . color($relPath, 'cyan') . "\n";
    echo "  Usage in any page: " . color("[include '{$includeDot}']\n\n", 'yellow');
}

/**
 * Handle make:error command.
 */
function handleMakeError(array $args, string $baseDir): void
{
    $code = $args[1] ?? null;

    if (!$code) {
        echo color("\n[!] Error: Please provide an HTTP error number (e.g. 404, 500, 403).\n", 'red');
        echo "Example: " . color("srin add error 404\n\n", 'yellow');
        exit(1);
    }

    $code = (int) $code;
    if ($code < 100 || $code > 599) {
        echo color("\n[!] Error: Invalid HTTP status code. Must be between 100 and 599.\n\n", 'red');
        exit(1);
    }

    $statusPhrases = [
        400 => 'Bad Request',
        401 => 'Unauthorized',
        403 => 'Forbidden',
        404 => 'Page Not Found',
        405 => 'Method Not Allowed',
        408 => 'Request Timeout',
        419 => 'Page Expired',
        422 => 'Unprocessable Entity',
        429 => 'Too Many Requests',
        500 => 'Internal Server Error',
        502 => 'Bad Gateway',
        503 => 'Service Unavailable',
        504 => 'Gateway Timeout',
    ];

    $statusText = $statusPhrases[$code] ?? 'Error';
    $errorsDir = $baseDir . '/Pages/errors';

    if (!is_dir($errorsDir)) {
        mkdir($errorsDir, 0755, true);
    }

    $filePath = $errorsDir . '/' . $code . '.srin.php';

    if (file_exists($filePath)) {
        echo color("\n[!] Error: Error template Pages/errors/{$code}.srin.php already exists.\n\n", 'yellow');
        exit(1);
    }

    $template = <<<HTML
[title '{$code} - {$statusText}']

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><?= \$title ?? '{$code} - {$statusText}' ?></title>
    <!-- Connect assets directly with [[ asset('/css/style.css') ]] -->
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #0b0f19;
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
