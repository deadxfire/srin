/**
 * Handle make:error command.
 */
function handleMakeError(array $args, string $baseDir): void
{
    $code = $args[1] ?? null;

    if (!$code) {
        echo color("\n[!] Error: Please provide an HTTP error number (e.g. 404, 500, 403).\n", 'red');
        echo "Example: " . color("php srin make:error 404\n\n", 'yellow');
        exit(1);
    }

    $code = (int) $code;
    if ($code < 100 || $code > 599) {
        echo color("\n[!] Error: Invalid HTTP status code. Must be between 100 and 599.\n\n", 'red');
        exit(1);
    }

    $statusPhrases = [
        400 => 'Bad Request',
        401 => 'Unauthorized',
        403 => 'Forbidden',
        404 => 'Page Not Found',
        405 => 'Method Not Allowed',
        408 => 'Request Timeout',
        419 => 'Page Expired',
        422 => 'Unprocessable Entity',
        429 => 'Too Many Requests',
        500 => 'Internal Server Error',
        502 => 'Bad Gateway',
        503 => 'Service Unavailable',
        504 => 'Gateway Timeout',
    ];

    $statusText = $statusPhrases[$code] ?? 'Error';
    $errorsDir = $baseDir . '/Pages/errors';

    if (!is_dir($errorsDir)) {
        mkdir($errorsDir, 0755, true);
    }

    $filePath = $errorsDir . '/' . $code . '.srin.php';

    if (file_exists($filePath)) {
        echo color("\n[!] Error: Error template Pages/errors/{$code}.srin.php already exists.\n\n", 'yellow');
        exit(1);
    }

    $template = <<<HTML
