#!/usr/bin/env php
<?php

/**
 * ============================================================================
 * Srin Engine CLI Tool (srin)
 * ============================================================================
 * Developed by Arindam Makar
 * Command line utility to generate controllers, pages, error pages, and manage the system.
 */

// Ensure this is run from CLI
if (php_sapi_name() !== 'cli') {
    die("This tool can only be run from the command line.\n");
}

define('SRIN_SECURE', true);

$baseDir = __DIR__;
$arguments = array_slice($argv, 1);
$command = $arguments[0] ?? 'help';

// Color formatting helpers for terminal
function color(string $text, string $color): string {
    $colors = [
        'green'  => "\033[32m",
        'red'    => "\033[31m",
        'yellow' => "\033[33m",
        'blue'   => "\033[34m",
        'cyan'   => "\033[36m",
        'bold'   => "\033[1m",
        'reset'  => "\033[0m",
    ];

    return ($colors[$color] ?? '') . $text . ($colors['reset'] ?? '');
}

switch ($command) {
    // -------------------------------------------------------------------------
    // Srin "add" Command: srin add <type> <name>
    // -------------------------------------------------------------------------
    case 'add':
    case 'create':
    case 'new':
        $sub = strtolower($arguments[1] ?? '');
        $subArgs = array_slice($arguments, 1);
        switch ($sub) {
            case 'controller':
                handleMakeController($subArgs, $baseDir);
                break;

            case 'checkpoint':
            case 'gate':
                handleMakeCheckpoint($subArgs, $baseDir);
                break;

            case 'model':
                handleMakeModel($subArgs, $baseDir);
                break;

            case 'migration':
                handleMakeMigration($subArgs, $baseDir);
                break;

            case 'seeder':
                handleMakeSeeder($subArgs, $baseDir);
                break;

            case 'page':
                handleMakePage($subArgs, $baseDir);
                break;

            case 'layout':
                handleMakeLayout($subArgs, $baseDir);
                break;

            case 'partial':
            case 'component':
                handleMakePartial($subArgs, $baseDir);
                break;

            case 'command':
            case 'cron':
            case 'job':
            case 'task':
                handleMakeCommand($subArgs, $baseDir);
                break;

            case 'error':
                handleMakeError($subArgs, $baseDir);
                break;

            default:
                echo color("\n[!] Please specify what to add: controller, model, migration, checkpoint, seeder, command, page, layout, partial, or error.\n", 'yellow');
                echo "Example: srin add controller About\n";
                echo "         srin add command SendWeeklyDigest\n\n";
                break;
        }
        break;

    // Custom CLI commands & cPanel cron jobs
    case 'command':
    case 'make:command':
        handleMakeCommand($arguments, $baseDir);
        break;

    case 'commands':
    case 'command:list':
        handleListCommands($baseDir);
        break;

    // Direct / legacy aliases for controllers
    case 'controller':
    case 'make:controller':
        handleMakeController($arguments, $baseDir);
        break;

    // Direct / legacy aliases for checkpoints
    case 'checkpoint':
    case 'gate':
    case 'make:checkpoint':
    case 'make:gate':
        handleMakeCheckpoint($arguments, $baseDir);
        break;

    // Direct / legacy aliases for models
    case 'model':
    case 'make:model':
        handleMakeModel($arguments, $baseDir);
        break;

    // Direct / legacy aliases for migrations
    case 'migration':
    case 'make:migration':
        handleMakeMigration($arguments, $baseDir);
        break;

    // Database migrations
    case 'migrate':
        $sub = strtolower($arguments[1] ?? '');
        if ($sub === 'fresh') {
            handleMigrateFresh(array_slice($arguments, 1), $baseDir);
        } elseif ($sub === 'rollback') {
            handleMigrateRollback($baseDir);
        } elseif ($sub === 'status') {
            handleMigrateStatus($baseDir);
        } else {
            handleMigrate($baseDir);
        }
        break;

    case 'migrate:rollback':
    case 'rollback':
        handleMigrateRollback($baseDir);
        break;

    case 'migrate:status':
        handleMigrateStatus($baseDir);
        break;

    case 'migrate:fresh':
        handleMigrateFresh($arguments, $baseDir);
        break;

    // Database seeders
    case 'seeder':
    case 'make:seeder':
        handleMakeSeeder($arguments, $baseDir);
        break;

    case 'db:seed':
    case 'seed':
        handleDbSeed($arguments, $baseDir);
        break;

    // Views, pages, layouts, partials
    case 'page':
    case 'make:page':
        handleMakePage($arguments, $baseDir);
        break;

    case 'layout':
    case 'make:layout':
        handleMakeLayout($arguments, $baseDir);
        break;

    case 'partial':
    case 'component':
    case 'make:partial':
    case 'make:component':
        handleMakePartial($arguments, $baseDir);
        break;

    case 'error':
    case 'make:error':
        handleMakeError($arguments, $baseDir);
        break;

    // Route links inspection
    case 'links':
    case 'link':
    case 'routes':
    case 'route:list':
        handleListRoutes($baseDir);
        break;

    // Real-time logs
    case 'logs':
    case 'log':
        handleLogs($arguments, $baseDir);
        break;

    // Cache / Log clearing
    case 'clear':
        $sub = strtolower($arguments[1] ?? '');
        if ($sub === 'logs' || $sub === 'log') {
            handleClearLogs($baseDir);
        } elseif ($sub === 'views' || $sub === 'view' || $sub === 'cache') {
            require_once $baseDir . '/Others/autoload.php';
            \Core\View::clearCache();
            echo color("\n[✓] Compiled view cache cleared successfully!\n\n", 'green');
        } else {
            echo color("\n[!] Please specify what to clear: 'logs' or 'cache'.\n", 'yellow');
            echo "Example: srin clear logs\n\n";
        }
        break;

    case 'clear:logs':
        handleClearLogs($baseDir);
        break;

    // Security encryption key
    case 'key':
        $sub = strtolower($arguments[1] ?? '');
        if ($sub === 'generate') {
            handleKeyGenerate(array_slice($arguments, 1), $baseDir);
        } else {
            handleKeyGenerate($arguments, $baseDir);
        }
        break;

    case 'key:generate':
        handleKeyGenerate($arguments, $baseDir);
        break;

    // Project initialization & setup (.env + APP_KEY + APP_NAME)
    case 'init':
    case 'setup':
        require_once $baseDir . '/Others/autoload.php';
        $force = in_array('--force', $arguments);
        \Core\Installer::setup($baseDir, $force);
        break;

    // Local dev server
    case 'dev':
    case 'serve':
    case 'up':
        handleServe($arguments);
        break;

    case 'run':
        $sub = $arguments[1] ?? null;
        if ($sub && !str_starts_with($sub, '-') && !is_numeric($sub)) {
            handleCustomCommand($sub, array_slice($arguments, 2), $baseDir);
        } else {
            handleServe($arguments);
        }
        break;

    // Self-updater
    case 'upgrade':
    case 'update':
        handleUpgrade($arguments, $baseDir);
        break;

    case 'help':
    case '--help':
    case '-h':
        showHelp();
        break;

    default:
        handleCustomCommand($command, array_slice($arguments, 1), $baseDir);
        break;
}

/**
 * Handle make:controller command.
 */
function handleMakeController(array $args, string $baseDir): void
{
    $name = $args[1] ?? null;
    $hasMailFlag = in_array('--mail', $args);

    if (!$name) {
        echo color("\n[!] Please specify a controller name.\n", 'yellow');
        echo "Usage: srin add controller <Name> [--mail]\n";
        echo "Example: srin add controller About\n";
        echo "         srin add controller Contact --mail\n\n";
        return;
    }

    $cleanName = preg_replace('/[^a-zA-Z0-9_]/', '', $name);
    if (!str_ends_with($cleanName, 'Controller')) {
        $cleanName .= 'Controller';
    }

    $controllerPath = $baseDir . "/Controller/{$cleanName}.php";

    if (file_exists($controllerPath)) {
        echo color("\n[X] Error: Controller [{$cleanName}] already exists at Controller/{$cleanName}.php\n\n", 'red');
        return;
    }

    $baseName = strtolower(str_replace('Controller', '', $cleanName));

    if ($hasMailFlag) {
        $template = <<<PHP
<?php

namespace Controller;

use Core\Mailer;
use Core\Request;
use Core\BaseController;

class {$cleanName} extends BaseController
{
    /**
     * Display the {$baseName} form or page.
     */
    public function index()
    {
        return \$this->render('{$baseName}', [
            'title' => '{$cleanName}'
        ]);
    }

    /**
     * Handle incoming contact / mail transfer with full anti-hacking defenses.
     */
    public function sendMail()
    {
        // 1. Rate Limiting: Max 5 submissions per minute per IP (prevents DoS & form flooding)
        \$this->rateLimit('contact-form', 5, 60);

        // 2. Verify CSRF Token (prevents Cross-Site Request Forgery)
        \$this->validateCsrf();

        // 3. Verify Honeypot field (silently traps and drops automated spam bots)
        \$this->validateHoneypot();

        // 4. Validate & sanitize inputs
        \$inputs = \$this->allInputs();
        \$errors = \$this->validate(\$inputs, [
            'name'    => 'required|min:2|max:100',
            'email'   => 'required|email',
            'subject' => 'required|min:3|max:150',
            'message' => 'required|min:10|max:5000',
        ]);

        if (!empty(\$errors)) {
            flash('error', reset(\$errors));
            return \$this->redirect('/{$baseName}');
        }

        // 5. Dispatch email using Core\Mailer (configured in Config/mail.php)
        try {
            Mailer::send([
                'to'         => config('mail.from.address', 'admin@example.com'),
                'subject'    => '[Contact Form] ' . Request::string('subject'),
                'body'       => sprintf(
                    "<h3>New Inquiry Received</h3><p><strong>Name:</strong> %s</p><p><strong>Email:</strong> %s</p><p><strong>Message:</strong><br>%s</p>",
                    htmlspecialchars(Request::string('name'), ENT_QUOTES, 'UTF-8'),
                    htmlspecialchars(Request::string('email'), ENT_QUOTES, 'UTF-8'),
                    nl2br(htmlspecialchars(Request::string('message'), ENT_QUOTES, 'UTF-8'))
                ),
                'is_html'    => true,
                'reply_to'   => Request::string('email'),
                'reply_name' => Request::string('name'),
            ]);

            flash('success', 'Your message has been sent successfully!');
        } catch (\Throwable \$e) {
            flash('error', 'Failed to send message: ' . \$e->getMessage());
        }

        return \$this->redirect('/{$baseName}');
    }
}
PHP;
    } else {
        $template = <<<PHP
<?php

namespace Controller;

use Core\BaseController;

class {$cleanName} extends BaseController
{
    /**
     * Display the index view.
     */
    public function index()
    {
        return \$this->render('{$baseName}', [
            'title' => '{$cleanName} Page'
        ]);
    }
}
PHP;
    }

    file_put_contents($controllerPath, $template);

    echo color("\n[✓] Controller created successfully!", 'green') . "\n";
    echo "  Location: " . color("Controller/{$cleanName}.php", 'cyan') . "\n";

    echo color("\nNext Step: Register route link in Routes/link.php:\n", 'yellow');
    if ($hasMailFlag) {
        echo color("  getlink('/{$baseName}', '{$cleanName}@index')->name('{$baseName}');\n", 'bold');
        echo color("  postlink('/{$baseName}', '{$cleanName}@sendMail')->name('{$baseName}.send');\n\n", 'bold');
    } else {
        echo color("  getlink('/{$baseName}', '{$cleanName}@index')->name('{$baseName}');\n\n", 'bold');
    }
}

/**
 * Handle make:checkpoint command.
 */
function handleMakeCheckpoint(array $args, string $baseDir): void
{
    $name = $args[1] ?? null;

    if (!$name) {
        echo color("\n[!] Please specify a checkpoint name.\n", 'yellow');
        echo "Usage: srin add checkpoint <Name>\n";
        echo "Example: srin add checkpoint VerifySubscription\n\n";
        return;
    }

    $cleanName = preg_replace('/[^a-zA-Z0-9_]/', '', $name);
    if (!str_ends_with($cleanName, 'Checkpoint')) {
        $cleanName .= 'Checkpoint';
    }

    $dir = $baseDir . '/Checkpoint';
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }

    $filePath = $dir . "/{$cleanName}.php";

    if (file_exists($filePath)) {
        echo color("\n[X] Error: Checkpoint [{$cleanName}] already exists at Checkpoint/{$cleanName}.php\n\n", 'red');
        return;
    }

    $template = <<<PHP
<?php

namespace Checkpoint;

use Core\Checkpoint;

class {$cleanName} extends Checkpoint
{
    /**
     * Inspect incoming request before controller executes.
     * Return true (or null) to ALLOW passage.
     * Return a redirect, Response, or false to HALT and block.
     */
    public function enter(): mixed
    {
        // Example logic:
        // if (!auth_check()) {
        //     flash('error', 'Please sign in to access this page.');
        //     redirect('/login');
        //     return false;
        // }

        return true;
    }

    /**
     * Optional filter executed after the controller finishes.
     */
    public function leave(mixed \$result): mixed
    {
        return \$result;
    }
}
PHP;

    file_put_contents($filePath, $template);

    echo color("\n[+] Success: Checkpoint [{$cleanName}] created at Checkpoint/{$cleanName}.php\n", 'green');
    echo "Usage in routes:\n";
    echo "  getlink('/secure', 'SecureController@index')->checkpoint(\Checkpoint\\{$cleanName}::class);\n\n";
}

