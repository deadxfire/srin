#!/usr/bin/env php
<?php

/**
 * ============================================================================
 * Srin Engine CLI Tool (srin)
 * ============================================================================
 * Developed by Arindam Makar
 * Command line utility to generate controllers, pages, error pages, and manage the system.
 */

// Ensure this is run from CLI
if (php_sapi_name() !== 'cli') {
    die("This tool can only be run from the command line.\n");
}

define('SRIN_SECURE', true);

$baseDir = __DIR__;
$arguments = array_slice($argv, 1);
$command = $arguments[0] ?? 'help';

// Color formatting helpers for terminal
function color(string $text, string $color): string {
    $colors = [
        'green'  => "\033[32m",
        'red'    => "\033[31m",
        'yellow' => "\033[33m",
        'blue'   => "\033[34m",
        'cyan'   => "\033[36m",
        'bold'   => "\033[1m",
        'reset'  => "\033[0m",
    ];

    return ($colors[$color] ?? '') . $text . ($colors['reset'] ?? '');
}

switch ($command) {
    case 'make:controller':
        handleMakeController($arguments, $baseDir);
        break;

    case 'make:page':
        handleMakePage($arguments, $baseDir);
        break;

    case 'make:layout':
        handleMakeLayout($arguments, $baseDir);
        break;

    case 'make:error':
        handleMakeError($arguments, $baseDir);
        break;

    case 'routes':
    case 'route:list':
        handleListRoutes($baseDir);
        break;

    case 'clear:logs':
        handleClearLogs($baseDir);
        break;

    case 'serve':
        handleServe($arguments);
        break;

    case 'help':
    case 'list':
    default:
        showHelp();
        break;
}

/**
 * Handle make:controller command.
 */
function handleMakeController(array $args, string $baseDir): void
{
    $name = $args[1] ?? null;
    $hasMailFlag = in_array('--mail', $args);

    if (!$name) {
        echo color("\n[!] Please specify a controller name.\n", 'yellow');
        echo "Usage: php srin make:controller <Name> [--mail]\n";
        echo "Example: php srin make:controller ContactController --mail\n\n";
        return;
    }

    $cleanName = preg_replace('/[^a-zA-Z0-9_]/', '', $name);
    if (!str_ends_with($cleanName, 'Controller')) {
        $cleanName .= 'Controller';
    }

    $controllerPath = $baseDir . "/Controller/{$cleanName}.php";

    if (file_exists($controllerPath)) {
        echo color("\n[X] Error: Controller [{$cleanName}] already exists at Controller/{$cleanName}.php\n\n", 'red');
        return;
    }

    $baseName = strtolower(str_replace('Controller', '', $cleanName));

    if ($hasMailFlag) {
        $template = <<<PHP
<?php

namespace Controller;

use Core\Mailer;
use Core\Request;

class {$cleanName} extends BaseController
{
    /**
     * Display the {$baseName} form or page.
     */
    public function index()
    {
        return \$this->render('{$baseName}', [
            'title' => '{$cleanName}'
        ]);
    }

    /**
     * Handle incoming contact / mail transfer with full anti-hacking defenses.
     */
    public function sendMail()
    {
        // 1. Rate Limiting: Max 5 submissions per minute per IP (prevents DoS & form flooding)
        \$this->rateLimit('contact-form', 5, 60);

        // 2. Verify CSRF Token (prevents Cross-Site Request Forgery)
        \$this->validateCsrf();

        // 3. Verify Honeypot field (silently traps and drops automated spam bots)
        \$this->validateHoneypot();

        // 4. Validate & sanitize inputs
        \$inputs = \$this->allInputs();
        \$errors = \$this->validate(\$inputs, [
            'name'    => 'required|min:2|max:100',
            'email'   => 'required|email',
            'subject' => 'required|min:3|max:150',
            'message' => 'required|min:10|max:5000',
        ]);

        if (!empty(\$errors)) {
            flash('error', reset(\$errors));
            return \$this->redirect('/{$baseName}');
        }

        // 5. Dispatch email using Core\Mailer (configured in Config/mail.php)
        try {
            Mailer::send([
                'to'         => config('mail.from.address', 'admin@example.com'),
                'subject'    => '[Contact Form] ' . Request::string('subject'),
                'body'       => sprintf(
                    "<h3>New Inquiry Received</h3><p><strong>Name:</strong> %s</p><p><strong>Email:</strong> %s</p><p><strong>Message:</strong><br>%s</p>",
                    htmlspecialchars(Request::string('name'), ENT_QUOTES, 'UTF-8'),
                    htmlspecialchars(Request::string('email'), ENT_QUOTES, 'UTF-8'),
                    nl2br(htmlspecialchars(Request::string('message'), ENT_QUOTES, 'UTF-8'))
                ),
                'is_html'    => true,
                'reply_to'   => Request::string('email'),
                'reply_name' => Request::string('name'),
            ]);

            flash('success', 'Your message has been sent successfully!');
        } catch (\Throwable \$e) {
            flash('error', 'Failed to send message: ' . \$e->getMessage());
        }

        return \$this->redirect('/{$baseName}');
    }
}
PHP;
    } else {
        $template = <<<PHP
<?php

namespace Controller;

class {$cleanName} extends BaseController
{
    /**
     * Display the index view.
     */
    public function index()
    {
        return \$this->render('{$baseName}', [
            'title' => '{$cleanName} Page'
        ]);
    }
}
PHP;
    }

    file_put_contents($controllerPath, $template);

    echo color("\n[✓] Controller created successfully!", 'green') . "\n";
    echo "  Location: " . color("Controller/{$cleanName}.php", 'cyan') . "\n";

    echo color("\nNext Step: Register route in Routes/web.php:\n", 'yellow');
    if ($hasMailFlag) {
        echo color("  Router::get('/{$baseName}', '{$cleanName}@index')->name('{$baseName}');\n", 'bold');
        echo color("  Router::post('/{$baseName}', '{$cleanName}@sendMail')->name('{$baseName}.send');\n\n", 'bold');
    } else {
        echo color("  Router::get('/{$baseName}', '{$cleanName}@index')->name('{$baseName}');\n\n", 'bold');
    }
}

