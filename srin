/**
 * Handle listing all routes.
 */
function handleListRoutes(string $baseDir): void
{
    // Autoload routes
    require_once $baseDir . '/Others/autoload.php';

    $routesFile = $baseDir . '/Routes/link.php';
    if (!file_exists($routesFile)) {
        $routesFile = $baseDir . '/Routes/web.php';
    }
    if (!file_exists($routesFile)) {
        echo color("\n[X] Routes/link.php file not found.\n\n", 'red');
        return;
    }

    require_once $routesFile;

    $routes = \Core\Router::getRoutes();

    if (empty($routes)) {
        echo color("\nNo route links registered in Routes/link.php\n\n", 'yellow');
        return;
    }

    echo "\n" . color("REGISTERED ROUTES:\n", 'bold');
    echo str_repeat('-', 95) . "\n";
    printf("%-8s | %-16s | %-25s | %-35s\n", "METHOD", "NAME", "PATH", "HANDLER");
    echo str_repeat('-', 95) . "\n";

    foreach ($routes as $route) {
        $method = $route->getMethod();
        $name = $route->getName() ?: '-';
        $path = $route->getPath();
        $handler = $route->getHandler();

        $handlerDesc = is_string($handler) ? $handler : 'Closure (anonymous function)';

        $methodColor = match ($method) {
            'GET'    => 'green',
            'POST'   => 'cyan',
            'PUT'    => 'yellow',
            'DELETE' => 'red',
            default  => 'bold'
        };

        printf("%-17s | %-16s | %-25s | %-35s\n", color($method, $methodColor), $name, $path, $handlerDesc);
    }

    echo str_repeat('-', 95) . "\n\n";
}

/**
 * Handle logs command.
 */
function handleLogs(array $args, string $baseDir): void
{
    $isMail = in_array('--mail', $args);
    $isClear = in_array('--clear', $args);
    $isTail = in_array('--tail', $args) || in_array('-f', $args);
    $linesCount = 25;

    foreach ($args as $arg) {
        if (str_starts_with($arg, '--lines=')) {
            $linesCount = max(1, (int) substr($arg, 8));
        }
    }

    $logFile = $baseDir . ($isMail ? '/Others/logs/mail.log' : '/Others/logs/srin.log');

    if ($isClear) {
        handleClearLogs($baseDir);
        return;
    }

    if (!file_exists($logFile) || filesize($logFile) === 0) {
        $name = $isMail ? 'Mail' : 'Application';
        echo color("\n[i] {$name} log is currently empty ({$logFile}).\n\n", 'cyan');
        return;
    }

    echo "\n" . color("=== Srin Engine Log Viewer (" . basename($logFile) . ") ===", 'bold') . "\n";
    echo "Path: " . color($logFile, 'cyan') . "\n\n";

    // Read last N lines
    $all = file($logFile, FILE_IGNORE_NEW_LINES);
    $lastLines = array_slice($all, -$linesCount);

    foreach ($lastLines as $line) {
        $formatted = $line;
        if (str_contains($line, 'ERROR:')) {
            $formatted = preg_replace('/(ERROR:)/', color('$1', 'red'), $formatted);
        } elseif (str_contains($line, 'WARNING:')) {
            $formatted = preg_replace('/(WARNING:)/', color('$1', 'yellow'), $formatted);
        } elseif (str_contains($line, 'INFO:')) {
            $formatted = preg_replace('/(INFO:)/', color('$1', 'green'), $formatted);
        } elseif (str_contains($line, 'DEBUG:')) {
            $formatted = preg_replace('/(DEBUG:)/', color('$1', 'cyan'), $formatted);
        }
        echo "  " . $formatted . "\n";
    }

    echo "\n" . color("Options: ", 'yellow');
    echo color("php srin logs -f", 'green') . " (live tail) | ";
    echo color("php srin logs --mail", 'green') . " (mail log) | ";
    echo color("php srin clear:logs", 'green') . " (clear)\n\n";

    if ($isTail) {
        echo color("Tailing {$logFile} in real-time... Press Ctrl+C to exit.\n\n", 'yellow');
        $lastSize = filesize($logFile);
        while (true) {
            clearstatcache(false, $logFile);
            $currentSize = filesize($logFile);
            if ($currentSize > $lastSize) {
                $handle = fopen($logFile, 'r');
                fseek($handle, $lastSize);
                while (($newChunk = fgets($handle)) !== false) {
                    echo "  " . trim($newChunk) . "\n";
                }
                $lastSize = ftell($handle);
                fclose($handle);
            } elseif ($currentSize < $lastSize) {
                $lastSize = 0;
            }
            usleep(500000);
        }
    }
}

/**
 * Handle clearing logs.
 */
function handleClearLogs(string $baseDir): void
{
    $appLog = $baseDir . '/Others/logs/srin.log';
    $mailLog = $baseDir . '/Others/logs/mail.log';
    $cleared = [];

    if (file_exists($appLog)) {
        file_put_contents($appLog, '');
        $cleared[] = 'srin.log';
    }
    if (file_exists($mailLog)) {
        file_put_contents($mailLog, '');
        $cleared[] = 'mail.log';
    }

    if (!empty($cleared)) {
        echo color("\n[✓] Logs cleared: " . implode(', ', $cleared) . " (Others/logs/)\n\n", 'green');
    } else {
        echo color("\n[i] Logs directory is already empty.\n\n", 'cyan');
    }
}

/**
 * Handle serve command.
 */
function handleServe(array $args): void
{
    $host = 'localhost';
    $port = 8000;

    for ($i = 0; $i < count($args); $i++) {
        $arg = $args[$i];

        if (str_starts_with($arg, '--port=')) {
            $port = (int) substr($arg, 7);
        } elseif ($arg === '--port' && isset($args[$i + 1])) {
            $port = (int) $args[++$i];
        } elseif (str_starts_with($arg, '--host=')) {
            $host = trim(substr($arg, 7));
        } elseif ($arg === '--host' && isset($args[$i + 1])) {
            $host = trim($args[++$i]);
        } elseif (str_starts_with($arg, '-p=')) {
            $port = (int) substr($arg, 3);
        } elseif ($arg === '-p' && isset($args[$i + 1])) {
            $port = (int) $args[++$i];
        } elseif (str_starts_with($arg, '-h=') && !in_array($arg, ['-h', '--help'])) {
            $host = trim(substr($arg, 3));
        } elseif (preg_match('/^([a-zA-Z0-9\.\_\-]+):(\d+)$/', $arg, $m)) {
            $host = $m[1];
            $port = (int) $m[2];
        } elseif (is_numeric($arg) && !in_array($arg, ['run', 'serve', 'dev', 'up'])) {
            $port = (int) $arg;
        }
    }

    if ($port <= 0 || $port > 65535) {
        $port = 8000;
    }
    $host = preg_replace('/[^a-zA-Z0-9\.\_\-]/', '', $host) ?: 'localhost';

    echo color("\nStarting Srin Engine server...\n", 'green');
    $displayHost = in_array($host, ['0.0.0.0', '::', '[::]']) ? 'localhost' : $host;
    echo "Host:         " . color("{$host}\n", 'cyan');
    echo "Port:         " . color("{$port}\n", 'cyan');
    echo "Local URL:    " . color("http://{$displayHost}:{$port}\n", 'cyan');
    if ($host === '0.0.0.0') {
        echo "Network URL:  " . color("http://<your-server-ip>:{$port}\n", 'cyan');
    }
    echo "Default page: " . color("Pages/welcome.srin.php\n", 'yellow');
    echo "Press Ctrl+C to stop.\n\n";

    passthru("php -S {$host}:{$port} index.php");
}

/**
 * Bootstrap Srin Application environment for CLI commands.
 */
function bootstrapApp(string $baseDir): void
{
    $autoload = $baseDir . '/Others/autoload.php';
    if (file_exists($autoload)) {
        require_once $autoload;
    } else {
        spl_autoload_register(function ($class) use ($baseDir) {
            $prefixes = [
                'Controller\\'        => $baseDir . '/Controller/',
                'Core\\'              => $baseDir . '/Core/',
                'Config\\'            => $baseDir . '/Config/',
                'Model\\'             => $baseDir . '/Model/',
                'Checkpoint\\'        => $baseDir . '/Checkpoint/',
                'Database\\Seeders\\' => $baseDir . '/database/seeders/',
                'Command\\'           => $baseDir . '/Command/',
            ];

            foreach ($prefixes as $prefix => $targetDir) {
                $len = strlen($prefix);
                if (strncmp($prefix, $class, $len) === 0) {
                    $relativeClass = substr($class, $len);
                    $file = $targetDir . str_replace('\\', '/', $relativeClass) . '.php';
                    if (file_exists($file)) {
                        require $file;
                        return;
                    }
                }
            }
        });

        if (file_exists($baseDir . '/Core/Helper.php')) {
            require_once $baseDir . '/Core/Helper.php';
        }
    }
    \Core\App::loadEnv($baseDir . '/.env');
}

/**
