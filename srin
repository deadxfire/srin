/**
 * Handle listing all routes.
 */
function handleListRoutes(string $baseDir): void
{
    // Autoload routes
    require_once $baseDir . '/Others/autoload.php';

    $routesFile = $baseDir . '/Routes/web.php';
    if (!file_exists($routesFile)) {
        echo color("\n[X] Routes/web.php file not found.\n\n", 'red');
        return;
    }

    require_once $routesFile;

    $routes = \Core\Router::getRoutes();

    if (empty($routes)) {
        echo color("\nNo routes registered in Routes/web.php\n\n", 'yellow');
        return;
    }

    echo "\n" . color("REGISTERED ROUTES:\n", 'bold');
    echo str_repeat('-', 95) . "\n";
    printf("%-8s | %-16s | %-25s | %-35s\n", "METHOD", "NAME", "PATH", "HANDLER");
    echo str_repeat('-', 95) . "\n";

    foreach ($routes as $route) {
        $method = $route->getMethod();
        $name = $route->getName() ?: '-';
        $path = $route->getPath();
        $handler = $route->getHandler();

        $handlerDesc = is_string($handler) ? $handler : 'Closure (anonymous function)';

        $methodColor = match ($method) {
            'GET'    => 'green',
            'POST'   => 'cyan',
            'PUT'    => 'yellow',
            'DELETE' => 'red',
            default  => 'bold'
        };

        printf("%-17s | %-16s | %-25s | %-35s\n", color($method, $methodColor), $name, $path, $handlerDesc);
    }

    echo str_repeat('-', 95) . "\n\n";
}

/**
 * Handle clearing mail logs.
 */
function handleClearLogs(string $baseDir): void
{
    $logFile = $baseDir . '/Others/logs/mail.log';
    if (file_exists($logFile)) {
        file_put_contents($logFile, '');
        echo color("\n[✓] Mail log (Others/logs/mail.log) cleared.\n\n", 'green');
    } else {
        echo color("\nNo mail log file found.\n\n", 'yellow');
    }
}

/**
 * Handle serve command.
 */
function handleServe(array $args): void
{
    $port = 8000;
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--port=')) {
            $port = (int) substr($arg, 7);
        }
    }

    echo color("\nStarting Srin Engine local server...\n", 'green');
    echo "URL: " . color("http://localhost:{$port}\n", 'cyan');
    echo "Default page: " . color("Pages/welcome.srin.php\n", 'yellow');
    echo "Press Ctrl+C to stop.\n\n";

    passthru("php -S localhost:{$port} index.php");
}

