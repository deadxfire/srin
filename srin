/**
 * Handle db:seed command.
 */
function handleDbSeed(array $args, string $baseDir): void
{
    bootstrapApp($baseDir);

    $className = 'DatabaseSeeder';
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--class=')) {
            $className = trim(substr($arg, 8));
        }
    }

    $cleanName = preg_replace('/[^a-zA-Z0-9_\\\\]/', '', $className);
    if (!str_ends_with($cleanName, 'Seeder')) {
        $cleanName .= 'Seeder';
    }

    echo color("\nRunning database seeders...\n", 'yellow');

    $seedersDir = $baseDir . '/database/seeders';
    $file = $seedersDir . '/' . str_replace(['Database\\Seeders\\', '\\'], ['', '/'], $cleanName) . '.php';

    if (file_exists($file)) {
        require_once $file;
    }

    $targetClass = null;
    $candidates = [
        $cleanName,
        "Database\\Seeders\\{$cleanName}",
        basename(str_replace('\\', '/', $cleanName)),
        "Database\\Seeders\\" . basename(str_replace('\\', '/', $cleanName)),
    ];

    foreach ($candidates as $cand) {
        if (class_exists($cand)) {
            $targetClass = $cand;
            break;
        }
    }

    if (!$targetClass) {
        echo color("\n[X] Error: Seeder class [{$cleanName}] not found in database/seeders/.\n\n", 'red');
        return;
    }

    try {
        $seeder = new $targetClass();
        if (!$seeder instanceof \Core\Seeder) {
            echo color("\n[X] Error: Class [{$targetClass}] must extend Core\\Seeder.\n\n", 'red');
            return;
        }

        $shortName = basename(str_replace('\\', '/', $targetClass));
        echo "  " . color('[DONE]', 'green') . " Seeded: {$shortName}\n";
        $seeder->run();

        echo color("\n[✓] Database seeding completed successfully!\n\n", 'green');
    } catch (\Throwable $e) {
        echo color("\n[X] Seeding Error: " . $e->getMessage() . "\n\n", 'red');
    }
}

/**
 * Handle make:command / add command.
 * Generates custom CLI command / cron job in Command/.
 */
function handleMakeCommand(array $args, string $baseDir): void
{
    $name = $args[1] ?? null;

    if (!$name) {
        echo color("\n[!] Please specify a command name.\n", 'yellow');
        echo "Usage: srin add command <Name>\n";
        echo "Example: srin add command SendWeeklyDigest\n";
        echo "         srin add command clean-expired-tokens\n\n";
        return;
    }

    // Convert kebab-case, snake_case, colon:separated, or StudlyCase to StudlyCase class name
    $parts = preg_split('/[-_:\s]+/', trim($name));
    $className = '';
    foreach ($parts as $part) {
