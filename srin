 */
function handleMakeModel(array $args, string $baseDir): void
{
    $name = $args[1] ?? null;

    if (!$name) {
        echo color("\n[!] Please specify a model name.\n", 'yellow');
        echo "Usage: srin add model <Name> [-m|--migration]\n";
        echo "Example: srin add model Post -m\n\n";
        return;
    }

    $cleanName = ucfirst(preg_replace('/[^a-zA-Z0-9_]/', '', $name));
    $modelDir = $baseDir . '/Model';
    if (!is_dir($modelDir)) {
        @mkdir($modelDir, 0755, true);
    }

    $modelPath = $modelDir . "/{$cleanName}.php";
    if (file_exists($modelPath)) {
        echo color("\n[X] Error: Model [{$cleanName}] already exists at Model/{$cleanName}.php\n\n", 'red');
        return;
    }

    // Determine default plural table name
    $short = $cleanName;
    $snake = strtolower(preg_replace('/(?<!^)[A-Z]/', '_$0', $short));
    $table = (str_ends_with($snake, 'y') && !preg_match('/[aeiou]y$/', $snake))
        ? substr($snake, 0, -1) . 'ies'
        : (str_ends_with($snake, 's') ? $snake . 'es' : $snake . 's');

    $template = <<<PHP
<?php

namespace Model;

use Core\Model;

/**
 * {$cleanName} Model
 * Table: {$table}
 */
class {$cleanName} extends Model
{
    /**
     * The table associated with the model.
     */
    protected static string \$table = '{$table}';

    /**
     * The attributes that are mass assignable.
     *
     * @var array<string>
     */
    protected array \$fillable = [
        // 'title', 'content', 'status',
    ];

    /**
     * The attributes that should be guarded from mass assignment.
     *
     * @var array<string>
     */
    protected array \$guarded = [
        'id',
    ];
}
PHP;

    file_put_contents($modelPath, $template);
    echo color("\n[✓] Model created successfully!", 'green') . "\n";
    echo "  Location: " . color("Model/{$cleanName}.php", 'cyan') . "\n";
    echo "  Table: " . color($table, 'yellow') . "\n";

    // Check for -m or --migration flag
    $hasMigration = in_array('-m', $args, true) || in_array('--migration', $args, true);
    if ($hasMigration) {
        $migrationName = "create_{$table}_table";
        handleMakeMigration(['make:migration', $migrationName], $baseDir, $table);
    } else {
        echo "\n";
    }
}

/**
 * Handle make:migration command.
 */
function handleMakeMigration(array $args, string $baseDir, ?string $targetTable = null): void
{
    $name = $args[1] ?? null;

    if (!$name) {
        echo color("\n[!] Please specify a migration name.\n", 'yellow');
        echo "Usage: srin add migration <name>\n";
        echo "Example: srin add migration create_posts_table\n\n";
        return;
    }

    $cleanName = strtolower(preg_replace('/[^a-zA-Z0-9_]/', '_', $name));
    $cleanName = trim($cleanName, '_');

    $migrationsDir = $baseDir . '/database/migrations';
    if (!is_dir($migrationsDir)) {
        @mkdir($migrationsDir, 0755, true);
    }

    $timestamp = date('Y_m_d_His');
    $filename = "{$timestamp}_{$cleanName}.php";
    $filePath = "{$migrationsDir}/{$filename}";

    // Guess table name if create_..._table pattern
    $table = $targetTable;
    if (!$table && preg_match('/^create_(.+)_table$/', $cleanName, $matches)) {
        $table = $matches[1];
    }
    $table = $table ?: 'my_table';

    $template = <<<PHP
<?php

use Core\Migration;
use Core\Schema;
use Core\Blueprint;

return new class extends Migration {
    /**
     * Run the migrations.
     */
    public function up(): void
    {
        Schema::create('{$table}', function (Blueprint \$table) {
            \$table->id();
            \$table->string('name');
            \$table->timestamps();
        });
    }

    /**
     * Reverse the migrations.
     */
    public function down(): void
    {
        Schema::dropIfExists('{$table}');
    }
};
PHP;

    file_put_contents($filePath, $template);
    echo color("\n[✓] Migration created successfully!", 'green') . "\n";
    echo "  File: " . color("database/migrations/{$filename}", 'cyan') . "\n";
    echo "  Run via: " . color("php srin migrate\n\n", 'yellow');
}

/**
 * Handle migrate command.
 */
function handleMigrate(string $baseDir): void
{
    bootstrapApp($baseDir);

    echo color("\nRunning database migrations...\n", 'cyan');
    $migrator = new \Core\Migrator($baseDir . '/database/migrations');

    $start = microtime(true);
    try {
        $applied = $migrator->run(function ($action, $file) {
            if ($action === 'migrating') {
                echo "  Migrating: " . color($file, 'yellow') . "\r";
            } elseif ($action === 'migrated') {
                echo "  " . color("[DONE]", 'green') . " Migrated: {$file}\n";
            }
        });

        $duration = round((microtime(true) - $start) * 1000, 2);

        if (empty($applied)) {
            echo color("Nothing to migrate. Database is already up to date.\n\n", 'green');
        } else {
            echo color("\n[✓] Migrations finished in {$duration}ms! (" . count($applied) . " applied)\n\n", 'green');
        }
    } catch (\Throwable $e) {
        echo color("\n[X] Migration Error: " . $e->getMessage() . "\n\n", 'red');
    }
}

