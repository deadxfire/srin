/**
 * Handle upgrade / update command.
 * Updates Srin default framework code with overwrite from GitHub while strictly preserving user project files.
 */
function handleUpgrade(array $args, string $baseDir): void
{
    echo "\n";
    echo color("========================================================\n", 'cyan');
    echo color("              Srin Engine System Upgrade                \n", 'bold');
    echo color("              Developed by Arindam Makar                \n", 'yellow');
    echo color("========================================================\n", 'cyan');

    $isForce  = in_array('--force', $args, true) || in_array('-f', $args, true);
    $isCheck  = in_array('--check', $args, true);
    $isDryRun = in_array('--dry-run', $args, true);

    $branch = 'main';
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--branch=')) {
            $branch = trim(substr($arg, 9));
        }
    }

    // Strictly validate branch name with a strict ref regex and reject '..'
    if (
        $branch === ''
        || str_contains($branch, '..')
        || str_starts_with($branch, '.')
        || str_ends_with($branch, '.')
        || str_starts_with($branch, '/')
        || str_ends_with($branch, '/')
        || !preg_match('/^[a-zA-Z0-9_.\-]+(?:\/[a-zA-Z0-9_.\-]+)*$/', $branch)
    ) {
        echo color("\n[X] Error: Invalid branch name '{$branch}'.\n\n", 'red');
        return;
    }

    // Determine local version
    $localVersion = '1.2.1';
    if (file_exists($baseDir . '/Core/App.php')) {
        $appCode = (string) file_get_contents($baseDir . '/Core/App.php');
        if (preg_match("/public const VERSION = '([^']+)';/", $appCode, $m)) {
            $localVersion = $m[1];
        }
    }

    echo "Local Srin Engine Version : " . color("v{$localVersion}", 'green') . "\n";
    echo "Connecting to GitHub repository [deadxfire/srin]...\n";

    // Fetch latest release or tag from GitHub
    $remoteVersion = null;
    $tagsJson = srinHttpGet('https://api.github.com/repos/deadxfire/srin/tags');
    if ($tagsJson) {
        $tagsData = json_decode($tagsJson, true);
        if (is_array($tagsData) && !empty($tagsData) && isset($tagsData[0]['name'])) {
            $remoteVersion = ltrim($tagsData[0]['name'], 'v');
        }
    }

    // Fallback: check raw Core/App.php from main branch
    if (!$remoteVersion) {
        $rawApp = srinHttpGet("https://raw.githubusercontent.com/deadxfire/srin/{$branch}/Core/App.php");
        if ($rawApp && preg_match("/public const VERSION = '([^']+)';/", $rawApp, $m)) {
            $remoteVersion = $m[1];
        }
    }

    if ($remoteVersion) {
        echo "Latest Remote Version     : " . color("v{$remoteVersion}", 'cyan') . "\n\n";
    } else {
        echo color("[!] Notice: Unable to verify remote release tag. Defaulting target to '{$branch}' branch.\n\n", 'yellow');
        $remoteVersion = $localVersion;
    }

    $hasUpdate = $remoteVersion && version_compare($remoteVersion, $localVersion, '>');

    // If --check mode:
    if ($isCheck) {
        if ($hasUpdate) {
            echo color("[!] Update Available: v{$remoteVersion} (Current: v{$localVersion})\n", 'yellow');
            echo "Run " . color("php srin upgrade", 'green') . " to upgrade.\n\n";
        } else {
            echo color("[✓] Srin Engine is up to date! (v{$localVersion})\n\n", 'green');
        }
        return;
    }

    // If not newer and not force:
    if (!$hasUpdate && !$isForce) {
        echo color("[✓] Your Srin Engine is already up to date (v{$localVersion})!\n", 'green');
        echo "If you wish to reinstall/overwrite the default system code with the latest repository code, run:\n";
        echo "  " . color("php srin upgrade --force\n\n", 'yellow');
        return;
    }

    if ($hasUpdate) {
        echo color("[!] Update available (v{$localVersion} -> v{$remoteVersion}). Beginning upgrade...\n", 'yellow');
    } else {
        echo color("[*] Force mode enabled: Overwriting default system files with latest '{$branch}' code...\n", 'cyan');
    }

    if ($isDryRun) {
        echo color("[i] Dry-run mode active. No files will be modified on disk.\n\n", 'yellow');
    }

    // Check prerequisites
    if (!class_exists('ZipArchive')) {
        echo color("\n[X] Error: The PHP 'zip' extension (ZipArchive) is required to perform upgrades.\n\n", 'red');
        return;
    }

    // Step 1: Download archive from GitHub
    $tempZip = sys_get_temp_dir() . '/srin_upgrade_' . bin2hex(random_bytes(16)) . '.zip';
    $downloadUrl = "https://codeload.github.com/deadxfire/srin/zip/refs/heads/{$branch}";
    echo "[1/4] Downloading update package from GitHub...\n";

    $downloadOk = srinDownloadFile($downloadUrl, $tempZip);
    if (!$downloadOk || !file_exists($tempZip) || filesize($tempZip) === 0) {
        // Fallback archive URL
        $fallbackUrl = "https://github.com/deadxfire/srin/archive/refs/heads/{$branch}.zip";
        $downloadOk = srinDownloadFile($fallbackUrl, $tempZip);
    }

    if (!$downloadOk || !file_exists($tempZip) || filesize($tempZip) === 0) {
        echo color("\n[X] Error: Failed to download update package from GitHub.\n", 'red');
        echo "Please check your network connection or verify that https://github.com/deadxfire/srin is accessible.\n\n";
        @unlink($tempZip);
        return;
    }

    $sizeKb = round(filesize($tempZip) / 1024, 1);
    echo "  " . color("[DONE]", 'green') . " Downloaded {$sizeKb} KB.\n";

    // Step 2: Extract archive
    echo "[2/4] Extracting package...\n";
    $tempExtractDir = sys_get_temp_dir() . '/srin_extract_' . bin2hex(random_bytes(16));
    @mkdir($tempExtractDir, 0700, true);

    $zip = new ZipArchive();
    if ($zip->open($tempZip) !== true) {
        echo color("\n[X] Error: Could not unpack zip archive.\n\n", 'red');
        @unlink($tempZip);
        srinDeleteDirectory($tempExtractDir);
        return;
    }

    // Reject entries that are absolute, contain .. segments or drive letters before extraction
    for ($i = 0; $i < $zip->numFiles; $i++) {
        $stat = $zip->statIndex($i);
        if ($stat === false || !isset($stat['name'])) {
            continue;
        }
        $entryName = $stat['name'];
        $normalized = str_replace('\\', '/', $entryName);

        if (
            str_starts_with($normalized, '/')
            || preg_match('/^[a-zA-Z]:/i', $normalized)
            || preg_match('#(^|/)\.\.(/|$)#', $normalized)
        ) {
            echo color("\n[X] Security Error: Zip archive contains illegal entry '{$entryName}'. Upgrade aborted.\n\n", 'red');
            $zip->close();
            @unlink($tempZip);
            srinDeleteDirectory($tempExtractDir);
            return;
        }
    }

    $zip->extractTo($tempExtractDir);
    $zip->close();
    @unlink($tempZip);

    // Locate inner root folder
    $sourceDir = $tempExtractDir;
    $entries = scandir($tempExtractDir);
    foreach ($entries as $entry) {
        if ($entry !== '.' && $entry !== '..' && is_dir($tempExtractDir . '/' . $entry)) {
            if (file_exists($tempExtractDir . '/' . $entry . '/Core')) {
                $sourceDir = $tempExtractDir . '/' . $entry;
                break;
            }
        }
    }

    if (!is_dir($sourceDir . '/Core')) {
        echo color("\n[X] Error: Invalid package structure received from GitHub.\n\n", 'red');
        srinDeleteDirectory($tempExtractDir);
        return;
    }

    echo "  " . color("[DONE]", 'green') . " Archive extracted successfully.\n";

    // Step 3: Overwrite default core files
    echo "[3/4] Overwriting default system files...\n";

    // A. Overwrite Core/
    if (is_dir($sourceDir . '/Core')) {
        $c = srinCopyDirectory($sourceDir . '/Core', $baseDir . '/Core', [], $isDryRun);
        echo "  " . color("[DONE]", 'green') . " Upgraded Core/ framework engine ({$c} files)\n";
    }

    // B. Upgrade Config/ (only copy brand new configuration files without overwriting existing ones)
    if (is_dir($sourceDir . '/Config')) {
        $c = 0;
        $configEntries = scandir($sourceDir . '/Config');
        if ($configEntries !== false) {
            foreach ($configEntries as $entry) {
                if ($entry !== '.' && $entry !== '..' && str_ends_with($entry, '.php')) {
                    $destFile = $baseDir . '/Config/' . $entry;
                    if (!file_exists($destFile)) {
                        if (!$isDryRun) {
                            copy($sourceDir . '/Config/' . $entry, $destFile);
                        }
                        $c++;
                    }
                }
            }
        }
        echo "  " . color("[DONE]", 'green') . " Preserved Config/ definitions ({$c} new files added)\n";
    }

    // C. Overwrite Others/ (excluding runtime logs)
    if (is_dir($sourceDir . '/Others')) {
        $c = srinCopyDirectory($sourceDir . '/Others', $baseDir . '/Others', ['logs'], $isDryRun);
        echo "  " . color("[DONE]", 'green') . " Upgraded Others/ vendors & autoloaders ({$c} files)\n";
    }

    // D. Overwrite root system scripts (preserve user composer.json)
    $rootFiles = [
        'srin',
        'srin.php',
        'index.php',
        '.htaccess',
        '.env.example',
        'README.md',
    ];

    foreach ($rootFiles as $file) {
        if (file_exists($sourceDir . '/' . $file)) {
            if (!$isDryRun) {
                copy($sourceDir . '/' . $file, $baseDir . '/' . $file);
                if ($file === 'srin' && function_exists('chmod')) {
                    @chmod($baseDir . '/srin', 0755);
                }
            }
            echo "  " . color("[DONE]", 'green') . " Upgraded {$file}\n";
        }
    }

    // E. Overwrite Pages/welcome.srin.php (default showcase and documentation)
    if (file_exists($sourceDir . '/Pages/welcome.srin.php')) {
        if (!$isDryRun) {
            @mkdir($baseDir . '/Pages', 0755, true);
            copy($sourceDir . '/Pages/welcome.srin.php', $baseDir . '/Pages/welcome.srin.php');
        }
        echo "  " . color("[DONE]", 'green') . " Upgraded Pages/welcome.srin.php\n";
    }

    // F. Overwrite default error templates if present
    if (is_dir($sourceDir . '/Pages/errors')) {
        $c = srinCopyDirectory($sourceDir . '/Pages/errors', $baseDir . '/Pages/errors', [], $isDryRun);
        echo "  " . color("[DONE]", 'green') . " Upgraded default Pages/errors/ templates ({$c} files)\n";
    }

    // Clean up temporary files
    echo "[4/4] Cleaning temporary files...\n";
    srinDeleteDirectory($tempExtractDir);
    echo "  " . color("[DONE]", 'green') . " Workspace clean.\n\n";

    echo color("STRICT USER DATA PRESERVATION GUARANTEE:\n", 'yellow');
    echo "  - Environment variables (.env)       : " . color("PRESERVED (Never touched)", 'green') . "\n";
    echo "  - Custom Controllers (Controller/)   : " . color("PRESERVED (Never touched)", 'green') . "\n";
    echo "  - Custom Models (Model/)             : " . color("PRESERVED (Never touched)", 'green') . "\n";
    echo "  - Database & Migrations (database/)  : " . color("PRESERVED (Never touched)", 'green') . "\n";
    echo "  - Static Assets & Media (assets/)    : " . color("PRESERVED (Never touched)", 'green') . "\n";
    echo "  - Custom Pages & Layouts (Pages/)    : " . color("PRESERVED (Never touched)", 'green') . "\n";
    echo "  - Git Repository (.git/)             : " . color("PRESERVED (Never touched)", 'green') . "\n\n";

    echo color("========================================================\n", 'cyan');
    echo color(" [✓] Srin Engine successfully upgraded!\n", 'green');
    echo color("========================================================\n\n", 'cyan');
}

/**
 * Automatically discover system CA bundle path across Windows, macOS, and Linux.
 */
function srinFindCaBundle(): ?string
{
    $candidates = [
        ini_get('curl.cainfo'),
        ini_get('openssl.cafile'),
        'C:\\Program Files\\Git\\mingw64\\etc\\ssl\\certs\\ca-bundle.crt',
        'C:\\Program Files\\Git\\usr\\ssl\\certs\\ca-bundle.crt',
        'C:\\Program Files (x86)\\Git\\mingw64\\etc\\ssl\\certs\\ca-bundle.crt',
        'C:\\Program Files (x86)\\Git\\usr\\ssl\\certs\\ca-bundle.crt',
        getenv('LOCALAPPDATA') ? getenv('LOCALAPPDATA') . '\\Programs\\Git\\mingw64\\etc\\ssl\\certs\\ca-bundle.crt' : null,
        getenv('APPDATA') ? getenv('APPDATA') . '\\Composer\\cacert.pem' : null,
        dirname(PHP_BINARY) . '\\extras\\ssl\\cacert.pem',
        dirname(PHP_BINARY) . '\\cacert.pem',
        '/etc/ssl/certs/ca-certificates.crt',
        '/etc/pki/tls/certs/ca-bundle.crt',
        '/etc/ssl/ca-bundle.pem',
        '/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem',
        '/etc/ssl/cert.pem',
        '/usr/local/share/certs/ca-root-nss.crt',
    ];

    foreach ($candidates as $path) {
        if ($path && is_string($path) && file_exists($path) && is_readable($path)) {
            return $path;
        }
    }

    return null;
}

/**
 * Perform an HTTP GET request with cURL, system curl, or stream context fallback.
 */
function srinHttpGet(string $url): ?string
{
    if (!str_starts_with(strtolower($url), 'https://')) {
        return null;
    }

    $caBundle = srinFindCaBundle();

    if (function_exists('curl_init')) {
        $ch = curl_init($url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_USERAGENT, 'Srin-Engine-Updater/1.0');
        curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
        curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, true);
        curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, 2);
        if ($caBundle) {
            curl_setopt($ch, CURLOPT_CAINFO, $caBundle);
        }
        if (defined('CURLOPT_REDIR_PROTOCOLS') && defined('CURLPROTO_HTTPS')) {
            curl_setopt($ch, CURLOPT_REDIR_PROTOCOLS, CURLPROTO_HTTPS);
        }
        if (defined('CURLOPT_PROTOCOLS') && defined('CURLPROTO_HTTPS')) {
            curl_setopt($ch, CURLOPT_PROTOCOLS, CURLPROTO_HTTPS);
        }
        curl_setopt($ch, CURLOPT_TIMEOUT, 15);
        $res = curl_exec($ch);
        $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        if ($res !== false && $code >= 200 && $code < 400) {
            return (string) $res;
        }
    }

    // Fallback 1: System curl (uses native OS certificate store e.g. Windows Schannel)
    $escapedUrl = escapeshellarg($url);
    $sysCurl = @shell_exec("curl -fsSL -A \"Srin-Engine-Updater/1.0\" {$escapedUrl} 2>&1");
    if ($sysCurl !== null && strlen(trim($sysCurl)) > 0 && !str_starts_with($sysCurl, 'curl:')) {
        return $sysCurl;
    }

    // Fallback 2: Stream context
    $sslOpts = [
        'verify_peer' => true,
        'verify_peer_name' => true,
        'allow_self_signed' => false,
    ];
    if ($caBundle) {
        $sslOpts['cafile'] = $caBundle;
    }

    $ctx = stream_context_create([
        'http' => [
            'method' => 'GET',
            'header' => "User-Agent: Srin-Engine-Updater/1.0\r\nAccept: application/vnd.github.v3+json\r\n",
            'timeout' => 15,
            'follow_location' => 1,
            'max_redirects' => 5,
        ],
        'ssl' => $sslOpts,
    ]);

    $data = @file_get_contents($url, false, $ctx);
    return $data !== false ? (string) $data : null;
}

/**
 * Stream-download a remote file to destination with multi-layer fallback.
 */
function srinDownloadFile(string $url, string $destination): bool
{
    if (!str_starts_with(strtolower($url), 'https://')) {
        return false;
    }

    $caBundle = srinFindCaBundle();

    $fp = @fopen($destination, 'w+');
    if (!$fp) {
        return false;
    }

    if (function_exists('curl_init')) {
        $ch = curl_init($url);
        curl_setopt($ch, CURLOPT_USERAGENT, 'Srin-Engine-Updater/1.0');
        curl_setopt($ch, CURLOPT_FILE, $fp);
        curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
        curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, true);
        curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, 2);
        if ($caBundle) {
            curl_setopt($ch, CURLOPT_CAINFO, $caBundle);
        }
        if (defined('CURLOPT_REDIR_PROTOCOLS') && defined('CURLPROTO_HTTPS')) {
            curl_setopt($ch, CURLOPT_REDIR_PROTOCOLS, CURLPROTO_HTTPS);
        }
        if (defined('CURLOPT_PROTOCOLS') && defined('CURLPROTO_HTTPS')) {
            curl_setopt($ch, CURLOPT_PROTOCOLS, CURLPROTO_HTTPS);
        }
        curl_setopt($ch, CURLOPT_TIMEOUT, 60);
        $success = curl_exec($ch);
        $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        fclose($fp);
        if ($success && ($code >= 200 && $code < 400) && file_exists($destination) && filesize($destination) > 0) {
            return true;
        }
    } else {
        fclose($fp);
    }

    // Fallback 1: System curl command
    @unlink($destination);
    $escapedUrl = escapeshellarg($url);
    $escapedDest = escapeshellarg($destination);
    @exec("curl -fsSL -A \"Srin-Engine-Updater/1.0\" {$escapedUrl} -o {$escapedDest} 2>&1", $output, $code);
    if ($code === 0 && file_exists($destination) && filesize($destination) > 0) {
        return true;
    }

    // Fallback 2: Stream context
    $fp = @fopen($destination, 'w+');
    if (!$fp) {
        return false;
    }

    $sslOpts = [
        'verify_peer' => true,
        'verify_peer_name' => true,
        'allow_self_signed' => false,
    ];
    if ($caBundle) {
        $sslOpts['cafile'] = $caBundle;
    }

    $ctx = stream_context_create([
        'http' => [
            'method' => 'GET',
            'header' => "User-Agent: Srin-Engine-Updater/1.0\r\n",
            'timeout' => 60,
            'follow_location' => 1,
            'max_redirects' => 5,
        ],
        'ssl' => $sslOpts,
    ]);

    $data = @file_get_contents($url, false, $ctx);
    if ($data !== false && strlen($data) > 0) {
        fwrite($fp, $data);
        fclose($fp);
        return true;
    }

    fclose($fp);
    @unlink($destination);
    return false;
}

/**
 * Recursively copy directory with exclusion support.
 */
function srinCopyDirectory(string $source, string $dest, array $exclude = [], bool $dryRun = false): int
{
    $copied = 0;
    if (!is_dir($dest) && !$dryRun) {
        @mkdir($dest, 0755, true);
    }

    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($source, RecursiveDirectoryIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST
    );

    foreach ($iterator as $item) {
        $subPath = substr($item->getPathname(), strlen($source) + 1);
        $subPath = str_replace('\\', '/', $subPath);

        foreach ($exclude as $pattern) {
            if ($subPath === $pattern || str_starts_with($subPath, $pattern . '/')) {
                continue 2;
            }
        }

        $target = $dest . '/' . $subPath;

        if ($item->isDir()) {
            if (!is_dir($target) && !$dryRun) {
                @mkdir($target, 0755, true);
            }
        } else {
            if (!$dryRun) {
                $dir = dirname($target);
                if (!is_dir($dir)) {
                    @mkdir($dir, 0755, true);
                }
                copy($item->getPathname(), $target);
            }
            $copied++;
        }
    }

    return $copied;
}

/**
 * Recursively delete directory.
 */
function srinDeleteDirectory(string $dir): bool
{
    if (!is_dir($dir)) {
        return false;
    }

    $files = array_diff(scandir($dir), ['.', '..']);
    foreach ($files as $file) {
        $path = $dir . '/' . $file;
        is_dir($path) ? srinDeleteDirectory($path) : @unlink($path);
    }

    return @rmdir($dir);
}

/**
 * Handle key:generate command.
 */
function handleKeyGenerate(array $args, string $baseDir): void
{
    require_once $baseDir . '/Core/Crypt.php';

    $force = in_array('--force', $args, true);
    $envFile = $baseDir . '/.env';

    if (!file_exists($envFile)) {
        if (file_exists($baseDir . '/.env.example')) {
            copy($baseDir . '/.env.example', $envFile);
            echo color("[i] Created .env file from .env.example\n", 'cyan');
        } else {
            file_put_contents($envFile, "APP_KEY=\n");
        }
    }

    $content = file_get_contents($envFile);

    // Preserve non-empty existing APP_KEY unless --force is passed
    if (preg_match('/^APP_KEY=(.+)$/m', $content, $m) && trim($m[1]) !== '' && !$force) {
        echo color("\n[!] Application key already exists. Use --force to regenerate and overwrite.\n\n", 'yellow');
        return;
    }

    $key = \Core\Crypt::generateKey();

    if (preg_match('/^APP_KEY=.*$/m', $content)) {
        $content = preg_replace_callback('/^APP_KEY=.*$/m', fn() => "APP_KEY={$key}", $content);
    } else {
        $content .= "\nAPP_KEY={$key}\n";
    }

    file_put_contents($envFile, $content);
    @chmod($envFile, 0600);

    echo color("\n[✓] Application key set successfully!\n\n", 'green');
}

