# App Configuration
APP_NAME="My Static Site"
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL="/"

# Mail Configuration
# Options for MAIL_DRIVER: 'smtp', 'mail' (PHP native mail), or 'log' (local file testing)
MAIL_DRIVER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@mysite.com
MAIL_FROM_NAME="My Static Site"
MAIL_ADMIN_ADDRESS=admin@mysite.com

