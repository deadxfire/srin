# App Configuration
APP_NAME="My Static Site"
APP_ENV=development
APP_DEBUG=false
APP_KEY=
APP_BASE_URL="/"

# Security & Password Hashing
# Supported algorithms: argon2id (recommended), bcrypt
AUTH_HASH_ALGO=argon2id
# Optional application pepper for keyed password hashing
# AUTH_PEPPER=

# Database Configuration
# Supported drivers: 'sqlite', 'mysql', 'pgsql'
DB_CONNECTION=sqlite
DB_DATABASE="database/database.sqlite"

# MySQL Configuration (Uncomment when using MySQL / MariaDB)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=srin_app
# DB_USERNAME=root
# DB_PASSWORD=
# DB_CHARSET=utf8mb4

# Mail Configuration
# Options for MAIL_DRIVER: 'smtp', 'mail' (PHP native mail), or 'log' (local file testing)
MAIL_DRIVER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@mysite.com
MAIL_FROM_NAME="My Static Site"
MAIL_ADMIN_ADDRESS=admin@mysite.com
