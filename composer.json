{
    "name": "deadxfire/srin",
    "description": "Srin - Lightweight, Secure Core PHP Static Website Engine developed by Arindam Makar",
    "type": "project",
    "keywords": [
        "srin",
        "deadxfire",
        "core-php",
        "static-site",
        "framework",
        "mailer",
        "arindam-makar"
    ],
    "homepage": "https://github.com/deadxfire/srin",
    "license": "MIT",
    "authors": [
        {
            "name": "Arindam Makar",
            "homepage": "https://github.com/deadxfire",
            "role": "Creator & Lead Architect"
        }
    ],
    "support": {
        "source": "https://github.com/deadxfire/srin"
    },
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "Controller\\": "Controller/",
            "Core\\": "Core/",
            "Config\\": "Config/",
            "Model\\": "Model/",
            "Checkpoint\\": "Checkpoint/",
            "Database\\Seeders\\": "database/seeders/",
            "Command\\": "Command/"
        },
        "files": [
            "Core/Helper.php"
        ]
    },
    "config": {
        "vendor-dir": "Others",
        "optimize-autoloader": true,
        "sort-packages": true,
        "process-timeout": 0
    },
    "bin": [
        "srin",
        "srin.php"
    ],
    "scripts": {
        "srin": "php srin",
        "dev": "php srin dev",
        "serve": "php srin dev",
        "links": "php srin links",
        "routes": "php srin links",
        "setup": "php srin init",
        "post-create-project-cmd": [
            "@php srin init"
        ]
    }
}
